# ============================================================
#  SUPPORT STAFF SUITE — переменные окружения
#  Скопируй в .env и заполни. Ничего не коммить!
# ============================================================

# ---------- 1. DISCORD APPLICATION ----------
# https://discord.com/developers/applications -> твоё приложение
DISCORD_TOKEN=            # Bot -> Reset Token
DISCORD_CLIENT_ID=        # General Information -> Application ID
DISCORD_CLIENT_SECRET=    # OAuth2 -> Client Secret (нужен для Activity)
DISCORD_PUBLIC_KEY=       # General Information -> Public Key

# ---------- 2. СЕРВЕР ----------
GUILD_ID=                 # ID сервера (ПКМ по серверу -> Copy Server ID)

# ---------- 3. РОЛИ ----------
SUPPORT_ROLE_ID=          # роль «Саппорт»
ADMIN_ROLE_ID=            # роль «вышка» (доступ к /admin, /award, /prime ...)

# ---------- 4. ГОЛОСОВОЙ КАНАЛ ----------
LOUNGE_VOICE_CHANNEL_ID=  # голосовой канал «Лаундж» (трекинг ПТ)

# ---------- 5. КАНАЛ #логи И ЕГО ВЕТКИ ----------
LOGS_CHANNEL_ID=          # сам канал #логи
THREAD_NEWS=              # ветка «Новости»
THREAD_WARNINGS=          # ветка «Выговоры»
THREAD_REMOVALS=          # ветка «Снятия»
THREAD_REPORTS=           # ветка «Отчёты»   <-- сюда падает суточный отчёт
THREAD_SHOP=              # ветка «Магазин»
THREAD_MEETINGS=          # ветка «Собрания»
THREAD_TOKENS=            # ветка «Токены»
THREAD_PRIMES=            # ветка «Прайм-таймы»
THREAD_SWAPS=             # ветка «Замены»

# ---------- 6. БАЗА ДАННЫХ ----------
# Локально через docker-compose: postgresql://support:support@localhost:5432/support?schema=public
# Если база уже используется другим ботом — добавь ?schema=support, иначе
# db:push предложит снести чужие таблицы. Подробности в docs/SETUP.md
DATABASE_URL=postgresql://support:support@localhost:5432/support?schema=public

# ---------- 7. ПРАВИЛА ПОДСЧЁТА ----------
PRIME_PASS_MINUTES=47     # минимум минут для галочки
PRIME_SLOT_MINUTES=60     # длина слота (показывается как «из требуемых 60»)
TIMEZONE=Europe/Moscow    # часовой пояс для крона 0:00
WEEKLY_RESET_DAY=1        # 1 = понедельник

# ---------- 8. ЭКОНОМИКА ----------
TOKENS_PER_PRIME=10       # начисление за успешный ПТ
SALARY_RATE=0.0365        # курс: прогноз зарплаты = tokens * SALARY_RATE
SALARY_CURRENCY=₽

# ---------- 9. MINI APP / ВЕБ-СЕРВЕР ----------
PORT=3000
# Публичный https-URL, который указан в Discord -> Activities -> URL Mappings
# Для локальной разработки — ссылка от cloudflared/ngrok
PUBLIC_BASE_URL=https://example.trycloudflare.com

# ---------- 10. ФРОНТ (apps/activity) ----------
# Дублируется в apps/activity/.env — Vite читает только VITE_*
VITE_DISCORD_CLIENT_ID=   # тот же, что DISCORD_CLIENT_ID
